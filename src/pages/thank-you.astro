---
import Layout from '../layouts/Layout.astro';

const title = 'You are on the list | Periscope';
const description =
  'Thanks for joining the Periscope waitlist. One email when audits open up, then nothing else.';
---

<Layout title={title} description={description}>
  <main class="mx-auto max-w-5xl px-6 py-20 md:px-10 md:py-28 lg:px-16">
    <!-- Masthead -->
    <header class="mb-16 flex items-baseline justify-between border-b border-[var(--color-rule)] pb-6 md:mb-24">
      <a href="/" class="font-display text-2xl text-[var(--color-ink)]">
        Periscope
      </a>
      <p class="section-label hidden sm:block">
        An LLM Visibility Audit
      </p>
    </header>

    <section class="mb-28 md:mb-36" aria-labelledby="thanks-heading">
      <div class="grid grid-cols-1 gap-x-10 md:grid-cols-12">
        <aside class="mb-6 md:col-span-2 md:mb-0">
          <p class="section-label">00 / Confirmation</p>
          <p class="mt-3 text-xs italic text-[var(--color-ink-soft)] font-display-italic">
            You are in
          </p>
        </aside>

        <div class="md:col-span-10">
          <h1
            id="thanks-heading"
            class="font-display text-5xl leading-[1.05] text-[var(--color-ink)] md:text-7xl lg:text-[5.5rem] lg:leading-[0.98]"
          >
            Thanks. Your email
            <span class="font-display-italic text-[var(--color-accent)]">landed.</span>
          </h1>

          <div class="mt-10 grid grid-cols-1 gap-x-10 gap-y-8 md:grid-cols-12">
            <div class="md:col-span-7">
              <p class="text-lg leading-relaxed text-[var(--color-ink-muted)] md:text-xl">
                You will hear from me once, when the first audit slots open up.
                No drip sequence, no "10 ways to dominate AI search" newsletter,
                no surprise pivots into a different product. One email, then
                nothing else unless you reply.
              </p>

              <p class="mt-6 text-base leading-relaxed text-[var(--color-ink-muted)]">
                If you want to send a URL ahead of the queue, my inbox is open
                at
                <a href="mailto:periscope@surdu.eu" class="link-underline">periscope@surdu.eu</a>.
                Tell me what your product is, who you compete with, and what
                you most want to know. The earliest audits will likely come
                from that thread.
              </p>
            </div>

            <aside class="md:col-span-5">
              <div class="border border-[var(--color-ink)] bg-[var(--color-paper-2)] p-6 md:p-8">
                <p class="section-label">What happens next</p>
                <ul class="mt-4 space-y-4 text-sm leading-relaxed text-[var(--color-ink-muted)]">
                  <li class="flex gap-3">
                    <span class="font-display-italic text-base text-[var(--color-accent)]">i.</span>
                    <span>Your address sits with Tally and with me. Nothing else is collected.</span>
                  </li>
                  <li class="flex gap-3">
                    <span class="font-display-italic text-base text-[var(--color-accent)]">ii.</span>
                    <span>When audits open, you get one note with a link to book.</span>
                  </li>
                  <li class="flex gap-3">
                    <span class="font-display-italic text-base text-[var(--color-accent)]">iii.</span>
                    <span>Want off the list before then? Reply to any message, or email me.</span>
                  </li>
                </ul>
              </div>
            </aside>
          </div>
        </div>
      </div>
    </section>

    <section class="mb-24 md:mb-32" aria-labelledby="meanwhile-heading">
      <div class="grid grid-cols-1 gap-x-10 md:grid-cols-12">
        <aside class="mb-6 md:col-span-2 md:mb-0">
          <p class="section-label">01 / Meanwhile</p>
        </aside>

        <div class="md:col-span-10">
          <h2
            id="meanwhile-heading"
            class="font-display text-3xl leading-tight text-[var(--color-ink)] md:text-5xl"
          >
            While you wait,
            <span class="font-display-italic">a few places to land.</span>
          </h2>

          <ul class="mt-12 divide-y divide-[var(--color-rule)] border-t border-b border-[var(--color-rule)]">
            <li class="grid grid-cols-12 items-baseline gap-6 py-6">
              <span class="col-span-2 font-display-italic text-2xl text-[var(--color-accent)] md:col-span-1 md:text-3xl">i.</span>
              <p class="col-span-10 text-base leading-relaxed text-[var(--color-ink)] md:col-span-11 md:text-lg">
                Re-read the
                <a href="/#artifact-heading" class="link-underline">visibility matrix</a>
                if you skipped past it. The format is the artifact.
              </p>
            </li>
            <li class="grid grid-cols-12 items-baseline gap-6 py-6">
              <span class="col-span-2 font-display-italic text-2xl text-[var(--color-accent)] md:col-span-1 md:text-3xl">ii.</span>
              <p class="col-span-10 text-base leading-relaxed text-[var(--color-ink)] md:col-span-11 md:text-lg">
                Look at
                <a href="https://surdu.de" class="link-underline">surdu.de</a>
                for the other small experiments. Periscope is one of them.
              </p>
            </li>
            <li class="grid grid-cols-12 items-baseline gap-6 py-6">
              <span class="col-span-2 font-display-italic text-2xl text-[var(--color-accent)] md:col-span-1 md:text-3xl">iii.</span>
              <p class="col-span-10 text-base leading-relaxed text-[var(--color-ink)] md:col-span-11 md:text-lg">
                Send me what you want to learn from your own audit. Specifics
                help me prioritize the queue.
              </p>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section class="mb-24 md:mb-32">
      <div class="grid grid-cols-1 gap-x-10 md:grid-cols-12">
        <aside class="mb-6 md:col-span-2 md:mb-0">
          <p class="section-label">Back</p>
        </aside>
        <div class="md:col-span-10">
          <p class="font-display-italic text-2xl text-[var(--color-ink)] md:text-3xl">
            <a href="/" class="link-underline">&larr; Back to Periscope</a>
          </p>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-[var(--color-ink)] pt-10">
      <div class="grid grid-cols-1 gap-x-10 gap-y-6 md:grid-cols-12">
        <div class="md:col-span-2">
          <p class="font-display text-xl text-[var(--color-ink)]">Periscope</p>
        </div>
        <div class="md:col-span-10">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <nav class="flex flex-col gap-2 text-sm text-[var(--color-ink-muted)] sm:flex-row sm:gap-8">
              <a href="https://surdu.de" class="link-underline">surdu.de hub</a>
              <a href="/privacy" class="link-underline">privacy</a>
              <a href="/imprint" class="link-underline">imprint</a>
              <a href="mailto:periscope@surdu.eu" class="link-underline">periscope@surdu.eu</a>
            </nav>
            <p class="font-display-italic text-xs text-[var(--color-ink-soft)]">
              &copy; {new Date().getFullYear()} Razvan Andrei Surdu
            </p>
          </div>
        </div>
      </div>
    </footer>
  </main>
</Layout>
