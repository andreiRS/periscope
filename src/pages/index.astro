---
import Layout from '../layouts/Layout.astro';

const title = 'Periscope: who is getting recommended to your customers instead of you?';
const description =
  'Periscope is an LLM Visibility Audit for indie SaaS founders. Find out who ChatGPT, Claude, Perplexity, and Gemini recommend to your customers instead of you, and why.';

const llms = ['ChatGPT', 'Claude', 'Perplexity', 'Gemini'];

type Cell = { brand: string; you?: boolean; empty?: boolean };

const matrix: { prompt: string; cells: Cell[] }[] = [
  {
    prompt: 'best note-taking app for researchers',
    cells: [
      { brand: 'Brand A' },
      { brand: 'Brand B' },
      { brand: 'Brand A' },
      { brand: 'Brand C' },
    ],
  },
  {
    prompt: 'alternatives to Notion for small teams',
    cells: [
      { brand: 'Brand D' },
      { brand: 'Brand A' },
      { brand: 'Brand D' },
      { brand: 'Brand E' },
    ],
  },
  {
    prompt: 'tools for managing customer feedback',
    cells: [
      { brand: 'Brand F' },
      { brand: 'Brand G' },
      { brand: '', empty: true },
      { brand: 'Brand F' },
    ],
  },
  {
    prompt: 'best help desk for small SaaS',
    cells: [
      { brand: 'Brand H' },
      { brand: 'Brand H' },
      { brand: 'Your brand', you: true },
      { brand: 'Brand I' },
    ],
  },
  {
    prompt: 'habit tracker that respects privacy',
    cells: [
      { brand: 'Brand J' },
      { brand: 'Brand K' },
      { brand: 'Brand J' },
      { brand: 'Brand L' },
    ],
  },
  {
    prompt: 'self-hosted analytics for indie founders',
    cells: [
      { brand: 'Brand M' },
      { brand: 'Brand N' },
      { brand: 'Brand M' },
      { brand: '', empty: true },
    ],
  },
  {
    prompt: 'email tools for newsletter creators',
    cells: [
      { brand: 'Brand O' },
      { brand: 'Brand P' },
      { brand: 'Brand O' },
      { brand: 'Brand Q' },
    ],
  },
  {
    prompt: 'Shopify alternatives for digital products',
    cells: [
      { brand: 'Brand R' },
      { brand: 'Brand S' },
      { brand: 'Brand R' },
      { brand: 'Brand T' },
    ],
  },
];
---

<Layout title={title} description={description}>
  <main class="mx-auto max-w-5xl px-6 py-20 md:px-10 md:py-28 lg:px-16">
    <!-- Masthead -->
    <header class="mb-16 flex items-baseline justify-between border-b border-[var(--color-rule)] pb-6 md:mb-24">
      <a href="/" class="font-display text-2xl text-[var(--color-ink)]">
        Periscope
      </a>
      <p class="section-label hidden sm:block">
        An LLM Visibility Audit
      </p>
    </header>

    <!-- 1. Hero -->
    <section class="mb-28 md:mb-36" aria-labelledby="hero-heading">
      <div class="grid grid-cols-1 gap-x-10 md:grid-cols-12">
        <aside class="mb-6 md:col-span-2 md:mb-0">
          <p class="section-label">01 / Hero</p>
          <p class="mt-3 text-xs italic text-[var(--color-ink-soft)] font-display-italic">
            Launching soon
          </p>
        </aside>

        <div class="md:col-span-10">
          <h1
            id="hero-heading"
            class="font-display text-5xl leading-[1.05] text-[var(--color-ink)] md:text-7xl lg:text-[5.5rem] lg:leading-[0.98]"
          >
            Who is ChatGPT
            <span class="font-display-italic text-[var(--color-accent)]">recommending</span>
            to your customers instead of you?
          </h1>

          <p class="mt-10 max-w-2xl text-lg leading-relaxed text-[var(--color-ink-muted)] md:text-xl">
            And right now, those answers name your competitors. In two
            business days, you get the full list: every brand named instead
            of you across ChatGPT, Claude, Perplexity, and Gemini, the
            prompts where you lost, and the fixes most likely to put you
            back in the answer. 30 to 50 buyer-intent queries, one flat-fee
            report.
          </p>

          <!-- Primary CTA -->
          <div class="mt-12 max-w-xl">
            <div class="border-t border-[var(--color-ink)] pt-5">
              <p class="section-label">The Waitlist</p>
              <a
                href="mailto:periscope@surdu.eu?subject=Periscope%20waitlist&amp;body=Hi%20Andrei%2C%0A%0AI%27d%20like%20to%20be%20on%20the%20Periscope%20waitlist.%0A%0AMy%20site%20(optional)%3A%20%0A%0AThanks"
                class="mt-5 inline-flex items-center gap-2 bg-[var(--color-ink)] px-5 py-3 text-sm font-medium tracking-wide text-[var(--color-paper)] transition hover:bg-[var(--color-accent)]"
              >
                Email me to join the waitlist
                <span aria-hidden="true">&rarr;</span>
              </a>
              <p class="mt-4 text-xs text-[var(--color-ink-soft)]">
                Or write directly to
                <a href="mailto:periscope@surdu.eu" class="link-underline">periscope@surdu.eu</a>.
                No third-party form. One email when audits open up, then
                nothing else.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. The artifact -->
    <section class="mb-28 md:mb-36" aria-labelledby="artifact-heading">
      <div class="grid grid-cols-1 gap-x-10 md:grid-cols-12">
        <aside class="mb-6 md:col-span-2 md:mb-0">
          <p class="section-label">02 / The artifact</p>
        </aside>

        <div class="md:col-span-10">
          <h2
            id="artifact-heading"
            class="font-display text-3xl leading-tight text-[var(--color-ink)] md:text-5xl"
          >
            Here is what lands in your inbox.
          </h2>

          <figure class="mt-12">
            <div class="overflow-x-auto border-t border-b border-[var(--color-ink)]">
              <table class="w-full min-w-[640px] border-collapse text-sm">
                <thead>
                  <tr class="border-b border-[var(--color-rule)]">
                    <th class="px-4 py-5 text-left font-display-italic text-base font-normal text-[var(--color-ink-muted)]">
                      Prompt
                    </th>
                    {llms.map((llm) => (
                      <th class="px-4 py-5 text-center font-display-italic text-base font-normal text-[var(--color-ink-muted)]">
                        {llm}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {matrix.map((row, i) => (
                    <tr class={i < matrix.length - 1 ? 'border-b border-[var(--color-rule-soft)]' : ''}>
                      <td class="px-4 py-5 text-[var(--color-ink)]">
                        <span class="font-display-italic text-base">{row.prompt}</span>
                      </td>
                      {row.cells.map((cell) => (
                        <td class="px-4 py-5 text-center">
                          {cell.empty ? (
                            <span class="text-[var(--color-ink-soft)]">&ndash;</span>
                          ) : cell.you ? (
                            <span class="inline-flex items-center bg-[var(--color-accent)] px-2.5 py-1 text-xs font-semibold tracking-wide text-[var(--color-paper)]">
                              {cell.brand}
                            </span>
                          ) : (
                            <span class="text-sm text-[var(--color-ink-muted)]">
                              {cell.brand}
                            </span>
                          )}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <figcaption class="mt-5 text-sm italic text-[var(--color-ink-soft)] font-display-italic">
              Real format. Anonymized data. Yours arrives as Markdown or PDF, inside
              2 business days of URL submission.
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 3. What is in the report -->
    <section class="mb-28 md:mb-36" aria-labelledby="report-heading">
      <div class="grid grid-cols-1 gap-x-10 md:grid-cols-12">
        <aside class="mb-6 md:col-span-2 md:mb-0">
          <p class="section-label">03 / The report</p>
        </aside>

        <div class="md:col-span-10">
          <h2
            id="report-heading"
            class="font-display text-3xl leading-tight text-[var(--color-ink)] md:text-5xl"
          >
            Three things,
            <span class="font-display-italic">in one document.</span>
          </h2>

          <div class="mt-12 grid grid-cols-1 gap-px bg-[var(--color-rule)] md:grid-cols-3 md:border md:border-[var(--color-rule)]">
            <article class="bg-[var(--color-paper)] p-7">
              <p class="font-display-italic text-sm text-[var(--color-accent)]">i.</p>
              <h3 class="mt-2 font-display text-2xl text-[var(--color-ink)]">
                Visibility matrix
              </h3>
              <p class="mt-4 text-sm leading-relaxed text-[var(--color-ink-muted)]">
                Every prompt, every LLM, every brand named. Your brand vs. the
                competition, at a glance.
              </p>
            </article>
            <article class="bg-[var(--color-paper)] p-7">
              <p class="font-display-italic text-sm text-[var(--color-accent)]">ii.</p>
              <h3 class="mt-2 font-display text-2xl text-[var(--color-ink)]">
                Competitor surface
              </h3>
              <p class="mt-4 text-sm leading-relaxed text-[var(--color-ink-muted)]">
                The named brands filling the slot your product should fill, sorted
                by frequency.
              </p>
            </article>
            <article class="bg-[var(--color-paper)] p-7">
              <p class="font-display-italic text-sm text-[var(--color-accent)]">iii.</p>
              <h3 class="mt-2 font-display text-2xl text-[var(--color-ink)]">
                Prioritized fix list
              </h3>
              <p class="mt-4 text-sm leading-relaxed text-[var(--color-ink-muted)]">
                Ranked by effort: 15 min, 1 day, 1 week. Each fix tied to a likely
                cause: positioning, schema, content coverage, or third-party
                mentions.
              </p>
            </article>
          </div>

          <p class="mt-10 max-w-3xl border-t border-[var(--color-rule)] pt-6 text-base leading-relaxed text-[var(--color-ink-muted)]">
            <span class="font-semibold text-[var(--color-ink)]">Two things sit underneath all three.</span>
            The matrix is diagnosed per LLM, because each one biases
            differently: ChatGPT cites vendor blogs, Perplexity skews
            household-name, Claude leans on parametric knowledge, Gemini on
            marketing tone. And every fix ships with a re-run protocol:
            which prompts to test again, in how many weeks, and the
            threshold for measuring lift.
          </p>
        </div>
      </div>
    </section>

    <!-- 4. How it works -->
    <section class="mb-28 md:mb-36" aria-labelledby="process-heading">
      <div class="grid grid-cols-1 gap-x-10 md:grid-cols-12">
        <aside class="mb-6 md:col-span-2 md:mb-0">
          <p class="section-label">04 / Process</p>
        </aside>

        <div class="md:col-span-10">
          <h2
            id="process-heading"
            class="font-display text-3xl leading-tight text-[var(--color-ink)] md:text-5xl"
          >
            From URL to report
            <span class="font-display-italic">in 2 business days.</span>
          </h2>

          <ol class="mt-12 divide-y divide-[var(--color-rule)] border-t border-b border-[var(--color-rule)]">
            <li class="grid grid-cols-12 items-baseline gap-6 py-6">
              <span class="col-span-2 font-display-italic text-2xl text-[var(--color-accent)] md:col-span-1 md:text-3xl">01</span>
              <p class="col-span-10 text-base leading-relaxed text-[var(--color-ink)] md:col-span-11 md:text-lg">
                You submit a landing page URL.
              </p>
            </li>
            <li class="grid grid-cols-12 items-baseline gap-6 py-6">
              <span class="col-span-2 font-display-italic text-2xl text-[var(--color-accent)] md:col-span-1 md:text-3xl">02</span>
              <p class="col-span-10 text-base leading-relaxed text-[var(--color-ink)] md:col-span-11 md:text-lg">
                I generate 30 to 50 buyer-intent prompts spanning discovery, comparison, and evaluation.
              </p>
            </li>
            <li class="grid grid-cols-12 items-baseline gap-6 py-6">
              <span class="col-span-2 font-display-italic text-2xl text-[var(--color-accent)] md:col-span-1 md:text-3xl">03</span>
              <p class="col-span-10 text-base leading-relaxed text-[var(--color-ink)] md:col-span-11 md:text-lg">
                Every prompt runs across ChatGPT, Claude, Perplexity, and Gemini.
              </p>
            </li>
            <li class="grid grid-cols-12 items-baseline gap-6 py-6">
              <span class="col-span-2 font-display-italic text-2xl text-[var(--color-accent)] md:col-span-1 md:text-3xl">04</span>
              <p class="col-span-10 text-base leading-relaxed text-[var(--color-ink)] md:col-span-11 md:text-lg">
                Mentions are tallied per brand per LLM into your visibility matrix.
              </p>
            </li>
            <li class="grid grid-cols-12 items-baseline gap-6 py-6">
              <span class="col-span-2 font-display-italic text-2xl text-[var(--color-accent)] md:col-span-1 md:text-3xl">05</span>
              <p class="col-span-10 text-base leading-relaxed text-[var(--color-ink)] md:col-span-11 md:text-lg">
                Your site is inspected against the 2 to 3 most likely causes of low visibility, and fixes are ranked by effort.
              </p>
            </li>
          </ol>
        </div>
      </div>
    </section>

    <!-- 5. Early findings -->
    <section class="mb-28 md:mb-36" aria-labelledby="findings-heading">
      <div class="grid grid-cols-1 gap-x-10 md:grid-cols-12">
        <aside class="mb-6 md:col-span-2 md:mb-0">
          <p class="section-label">05 / Early findings</p>
        </aside>

        <div class="md:col-span-10">
          <h2
            id="findings-heading"
            class="font-display text-3xl leading-tight text-[var(--color-ink)] md:text-5xl"
          >
            What early runs
            <span class="font-display-italic">surfaced.</span>
          </h2>

          <div class="mt-12 max-w-2xl space-y-10 text-lg leading-relaxed text-[var(--color-ink-muted)]">
            <p class="border-l-2 border-[var(--color-accent)] pl-6">
              <span class="block font-display text-3xl text-[var(--color-ink)]">0 out of 115.</span>
              <span class="mt-2 block">
                An indie SaaS 4 days post-launch. Zero mentions across every
                prompt-LLM combination. The cold start is real and measurable.
              </span>
            </p>
            <p class="border-l-2 border-[var(--color-accent)] pl-6">
              <span class="block font-display text-3xl text-[var(--color-ink)]">6 out of 160 (3.75%).</span>
              <span class="mt-2 block">
                A Shopify-adjacent tool with active users. The audit also surfaced a
                positioning gap between their landing page and their app store
                listing that was invisible to them before the run.
              </span>
            </p>
            <p class="border-l-2 border-[var(--color-accent)] pl-6">
              <span class="block font-display text-3xl text-[var(--color-ink)]">Cross-LLM brand variance.</span>
              <span class="mt-2 block">
                The same prompt to ChatGPT, Claude, Perplexity, and Gemini returns
                different brand sets. There is no single "AI search" channel to
                optimize for.
              </span>
            </p>
          </div>

          <p class="mt-10 max-w-2xl border-t border-[var(--color-rule)] pt-5 font-display-italic text-sm text-[var(--color-ink-soft)]">
            Small sample from beta. The numbers will move; the patterns probably
            will not.
          </p>
        </div>
      </div>
    </section>

    <!-- 6. What I have learned -->
    <section class="mb-28 md:mb-36" aria-labelledby="notes-heading">
      <div class="grid grid-cols-1 gap-x-10 md:grid-cols-12">
        <aside class="mb-6 md:col-span-2 md:mb-0">
          <p class="section-label">06 / Field notes</p>
        </aside>

        <div class="md:col-span-10">
          <h2
            id="notes-heading"
            class="font-display text-3xl leading-tight text-[var(--color-ink)] md:text-5xl"
          >
            Four notes
            <span class="font-display-italic">from the runs so far.</span>
          </h2>

          <ol class="mt-12 grid grid-cols-1 gap-x-10 gap-y-10 md:grid-cols-2">
            <li>
              <p class="font-display-italic text-2xl text-[var(--color-accent)]">i.</p>
              <p class="mt-2 text-base leading-relaxed text-[var(--color-ink-muted)]">
                LLMs return different brand sets for the same prompt. You cannot
                optimize for "AI search" as a single channel.
              </p>
            </li>
            <li>
              <p class="font-display-italic text-2xl text-[var(--color-accent)]">ii.</p>
              <p class="mt-2 text-base leading-relaxed text-[var(--color-ink-muted)]">
                Vendor-published comparison content ("X vs Y vs Z" listicles on the
                vendor's own blog) is currently the most reliable way in.
              </p>
            </li>
            <li>
              <p class="font-display-italic text-2xl text-[var(--color-accent)]">iii.</p>
              <p class="mt-2 text-base leading-relaxed text-[var(--color-ink-muted)]">
                API and consumer-chat outputs diverge. Consumer UIs may pull live
                web search; APIs often will not. Both need tracking.
              </p>
            </li>
            <li>
              <p class="font-display-italic text-2xl text-[var(--color-accent)]">iv.</p>
              <p class="mt-2 text-base leading-relaxed text-[var(--color-ink-muted)]">
                Fixes take weeks to surface in LLM outputs. Re-runs matter more than
                one-shots.
              </p>
            </li>
          </ol>

          <dl class="mt-14 grid grid-cols-1 gap-6 border-t border-[var(--color-rule)] pt-6 md:grid-cols-2">
            <div>
              <dt class="font-display-italic text-base text-[var(--color-ink)]">AEO.</dt>
              <dd class="mt-1 text-sm text-[var(--color-ink-muted)]">
                Answer Engine Optimization. Getting picked up in AI answers.
              </dd>
            </div>
            <div>
              <dt class="font-display-italic text-base text-[var(--color-ink)]">GEO.</dt>
              <dd class="mt-1 text-sm text-[var(--color-ink-muted)]">
                Generative Engine Optimization. Same idea, different acronym.
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <!-- 7. Waitlist (repeated) -->
    <section class="mb-28 md:mb-36" aria-labelledby="waitlist-heading">
      <div class="grid grid-cols-1 gap-x-10 md:grid-cols-12">
        <aside class="mb-6 md:col-span-2 md:mb-0">
          <p class="section-label">07 / Waitlist</p>
        </aside>

        <div class="md:col-span-10">
          <div class="border border-[var(--color-ink)] bg-[var(--color-paper-2)] p-8 md:p-12">
            <h2
              id="waitlist-heading"
              class="font-display text-3xl leading-tight text-[var(--color-ink)] md:text-5xl"
            >
              Want one
              <span class="font-display-italic">when audits open up?</span>
            </h2>
            <p class="mt-4 max-w-xl text-base leading-relaxed text-[var(--color-ink-muted)] md:text-lg">
              Send me an email and I will add you to the list. I will message
              you the moment the first slots open.
            </p>
            <a
              href="mailto:periscope@surdu.eu?subject=Periscope%20waitlist&amp;body=Hi%20Andrei%2C%0A%0AI%27d%20like%20to%20be%20on%20the%20Periscope%20waitlist.%0A%0AMy%20site%20(optional)%3A%20%0A%0AThanks"
              class="mt-8 inline-flex items-center gap-2 bg-[var(--color-ink)] px-5 py-3 text-sm font-medium tracking-wide text-[var(--color-paper)] transition hover:bg-[var(--color-accent)]"
            >
              Email me to join the waitlist
              <span aria-hidden="true">&rarr;</span>
            </a>
            <p class="mt-4 text-xs text-[var(--color-ink-soft)]">
              First batch will be small. I will keep the queue honest. Or
              write directly to
              <a href="mailto:periscope@surdu.eu" class="link-underline">periscope@surdu.eu</a>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 8. About -->
    <section class="mb-24 md:mb-32" aria-labelledby="about-heading">
      <div class="grid grid-cols-1 gap-x-10 md:grid-cols-12">
        <aside class="mb-6 md:col-span-2 md:mb-0">
          <p class="section-label">08 / Colophon</p>
        </aside>

        <div class="md:col-span-10">
          <h2
            id="about-heading"
            class="font-display text-3xl leading-tight text-[var(--color-ink)] md:text-5xl"
          >
            Who is
            <span class="font-display-italic">running this.</span>
          </h2>
          <p class="mt-8 max-w-2xl text-lg leading-relaxed text-[var(--color-ink-muted)]">
            I am Andrei. I am building Periscope after running early audits
            across a handful of indie SaaS products and watching the same
            patterns show up. If you want to talk before signing up, my inbox
            is open at
            <a href="mailto:periscope@surdu.eu" class="link-underline">periscope@surdu.eu</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- 9. Footer -->
    <footer class="border-t border-[var(--color-ink)] pt-10">
      <div class="grid grid-cols-1 gap-x-10 gap-y-6 md:grid-cols-12">
        <div class="md:col-span-2">
          <p class="font-display text-xl text-[var(--color-ink)]">Periscope</p>
        </div>
        <div class="md:col-span-10">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <nav class="flex flex-col gap-2 text-sm text-[var(--color-ink-muted)] sm:flex-row sm:gap-8">
              <a href="/imprint" class="link-underline">Imprint</a>
              <a href="/privacy" class="link-underline">Privacy</a>
            </nav>
            <p class="font-display-italic text-xs text-[var(--color-ink-soft)]">
              &copy; {new Date().getFullYear()} Razvan Andrei Surdu
            </p>
          </div>
        </div>
      </div>
    </footer>
  </main>
</Layout>
