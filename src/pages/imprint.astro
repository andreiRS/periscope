---
import Layout from '../layouts/Layout.astro';

const title = 'Imprint | Periscope';
const description =
  'Legal notice (Impressum per TMG §5 / DDG §5) for periscope.surdu.de.';
---

<Layout title={title} description={description}>
  <main class="mx-auto max-w-3xl px-6 py-16 md:py-24">
    <p class="mb-4 text-sm font-medium uppercase tracking-wider text-zinc-500">
      Legal
    </p>
    <h1 class="text-3xl font-semibold tracking-tight text-zinc-950 md:text-4xl">
      Imprint
    </h1>
    <p class="mt-4 text-sm text-zinc-500">
      Information per § 5 DDG (formerly TMG) and § 18 Abs. 2 MStV.
    </p>

    <section class="prose mt-10 max-w-none text-zinc-700">
      <h2 class="text-xl font-semibold text-zinc-950">Operator</h2>
      <p class="mt-2 leading-relaxed">
        Andrei Surdu<br />
        [STREET AND HOUSE NUMBER]<br />
        [POSTAL CODE] [CITY]<br />
        Germany
      </p>

      <h2 class="mt-8 text-xl font-semibold text-zinc-950">Contact</h2>
      <p class="mt-2 leading-relaxed">
        Email: <a href="mailto:andrei@surdu.eu" class="underline underline-offset-4 hover:text-zinc-950">andrei@surdu.eu</a>
      </p>

      <h2 class="mt-8 text-xl font-semibold text-zinc-950">VAT</h2>
      <p class="mt-2 leading-relaxed">
        VAT ID (Umsatzsteuer-Identifikationsnummer per § 27 a UStG):
        [VAT ID OR "Not applicable, small business under § 19 UStG"]
      </p>

      <h2 class="mt-8 text-xl font-semibold text-zinc-950">
        Responsible for content
      </h2>
      <p class="mt-2 leading-relaxed">
        Per § 18 Abs. 2 MStV: Andrei Surdu, address as above.
      </p>

      <h2 class="mt-8 text-xl font-semibold text-zinc-950">
        EU online dispute resolution
      </h2>
      <p class="mt-2 leading-relaxed">
        The European Commission provides a platform for online dispute
        resolution at
        <a
          href="https://ec.europa.eu/consumers/odr"
          class="underline underline-offset-4 hover:text-zinc-950"
          rel="noopener"
        >https://ec.europa.eu/consumers/odr</a>.
        I am not obliged and not willing to participate in dispute resolution
        proceedings before a consumer arbitration board.
      </p>

      <h2 class="mt-8 text-xl font-semibold text-zinc-950">Liability</h2>
      <p class="mt-2 leading-relaxed">
        Content on this site is prepared with care, but I make no warranty
        regarding accuracy, completeness, or timeliness. External links point
        to third-party sites whose content I do not control and for which I
        assume no liability.
      </p>

      <p class="mt-10 text-sm text-zinc-500">
        Last updated: [YYYY-MM-DD]
      </p>
    </section>

    <p class="mt-12 text-sm">
      <a href="/" class="underline underline-offset-4 hover:text-zinc-950">
        &larr; Back to Periscope
      </a>
    </p>
  </main>
</Layout>
